# Mutant Tools — static site on cPanel / Apache.

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # media that used to sit in wp-content/uploads
  RewriteRule ^wp-content/uploads/\d{4}/\d{2}/(.+)$ /assets/img/$1 [R=301,QSD,L]
  # everything else WordPress -> home
  RewriteRule ^(wp-admin|wp-includes|wp-content|wp-login\.php|xmlrpc\.php|wp-json|index\.php)(/.*)?$ / [R=301,QSD,L]
  # old WordPress leftovers Search Console still crawls
  RewriteRule ^(comments/)?feed(/.*)?$ / [R=301,QSD,L]
  RewriteRule ^page/\d+/?$ / [R=301,QSD,L]
  RewriteRule ^\d+/?$ / [R=301,QSD,L]
  RewriteRule ^\d{4}/\d{2}/ / [R=301,QSD,L]
  RewriteRule ^(author|category|tag)/ / [R=301,QSD,L]
  RewriteRule ^(hello-world|sample-page|pro-users|reel)/?$ / [R=301,QSD,L]
  RewriteRule ^\*/?$ / [R=301,QSD,L]
  # Yoast / Rank Math sitemaps
  RewriteRule ^(sitemap_index|[a-z0-9_-]+-sitemap(-?\d+)?)\.xml$ /sitemap.xml [R=301,QSD,L]
  # moved pages
  RewriteRule ^download/?$ https://github.com/RenderDeMartes/Mutant_Tools [R=301,QSD,L]
  RewriteRule ^learn/rigger/?$ /rigger/ [R=301,QSD,L]
  RewriteRule ^riggers/?$ /rigger/ [R=301,QSD,L]
  RewriteRule ^developers/?$ /developer/ [R=301,QSD,L]
  RewriteRule ^block-builder/?$ /wiki/blocks/ [R=301,QSD,L]
  RewriteRule ^code-snipets/?$ /wiki/commands/ [R=301,QSD,L]
  RewriteRule ^resources/?$ /free-assets/ [R=301,QSD,L]
  RewriteRule ^tools/?$ /free-maya-rigging-tools/ [R=301,QSD,L]
  RewriteRule ^installation-guide/?$ /free-maya-rigging-tools/#install [R=301,NE,QSD,L]

  # trailing slash on directory URLs
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{2,5}|/)$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
